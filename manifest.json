{
  "manifest_version": 3,
  "name": "Kogama Account Switcher",
  "version": "1.0.0",
  "description": "Adds \"Switch Account\" and \"Silent Logout\" buttons to the Kogama profile menu. Save multiple accounts and switch between them with one click.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "*://*.kogama.com/*",
    "*://*.kgoma.com/*",
    "*://*.kogstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.kogama.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Kogama Account Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
